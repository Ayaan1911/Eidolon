PORT=8000

# Optional: raises the GitHub API limit from 60/hour to 5000/hour for the repo secret scan
GITHUB_TOKEN=

# Required for the honeytoken trap: signs and verifies decoy API keys.
# Any long random string works, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Must stay the same across restarts/redeploys, or keys generated before the
# change stop verifying.
HONEYTOKEN_SECRET=

# Optional: without this, trap triggers still fire (and honeytoken checks still
# work), just with no push alert. ntfy.sh needs no account or token - pick a
# long random topic name (anyone who knows it can read or post to it, so don't
# use something guessable), e.g. `python -c "import secrets; print('eidolon-trap-' + secrets.token_urlsafe(18))"`.
# Then subscribe to it in the ntfy app, or watch https://ntfy.sh/<topic> in a browser.
NTFY_TOPIC=

# Required once the frontend is deployed: comma-separated origins allowed to call
# this API from a browser, e.g. https://eidolon.vercel.app (scheme + host, no path).
# Localhost dev ports are always allowed. Vercel preview URLs are NOT covered -
# add each one you want to use, or leave them out.
CORS_ORIGINS=

# Required for the Trap Lab admin login: the passphrase only you know. Without it
# nobody can log in, so Trap Lab stays in demo mode. Pick something long; login
# is rate limited but this is still the only thing standing between a stranger
# and real trap creation. Changing or unsetting it immediately invalidates every
# admin session already issued. Sessions also expire on their own after 24 hours.
ADMIN_KEY=
