PORT=8000

# Optional: raises the GitHub API limit from 60/hour to 5000/hour for the repo secret scan
GITHUB_TOKEN=

# Optional: without these, trap triggers still log to the DB, just with no push alert.
# TELEGRAM_BOT_TOKEN: message @BotFather on Telegram, /newbot, and copy the token it gives you
# TELEGRAM_CHAT_ID: message your new bot once, then message @userinfobot to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
