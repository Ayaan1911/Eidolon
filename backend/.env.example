PORT=8000

# Optional but recommended: the repo secret scanner calls GitHub's API several
# times per repo (list repos, then a tree fetch per repo). Without this, those
# calls are unauthenticated and capped at 60/hour for your server's IP - shared
# hosts (Render, etc.) exhaust that fast, and scans then come back incomplete.
# A classic personal access token with no scopes selected is enough (this only
# ever reads public repos) and raises the cap to 5,000/hour. Create one at
# https://github.com/settings/tokens.
GITHUB_TOKEN=

# Required for the honeytoken trap: signs and verifies decoy API keys. At least 16 characters;
# the app refuses to start if it is blank, too short, or still the CHANGE_ME placeholder below.
# Any long random string works, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Must stay the same across restarts/redeploys, or keys generated before the
# change stop verifying.
HONEYTOKEN_SECRET=CHANGE_ME_generate_with_the_command_above
# Optional: without this, trap triggers still fire (and honeytoken checks still
# work), just with no push alert. ntfy.sh needs no account or token - pick a
# long random topic name (anyone who knows it can read or post to it, so don't
# use something guessable), e.g. `python -c "import secrets; print('eidolon-trap-' + secrets.token_urlsafe(18))"`.
# Then subscribe to it in the ntfy app, or watch https://ntfy.sh/<topic> in a browser.
NTFY_TOPIC=

# Required once the frontend is deployed: comma-separated origins allowed to call
# this API from a browser, e.g. https://eidolon.vercel.app (scheme + host, no path).
# Localhost dev ports are always allowed. Vercel preview URLs are NOT covered -
# add each one you want to use, or leave them out.
CORS_ORIGINS=

# Required for the Trap Lab admin login: the passphrase only you know. Without it
# nobody can log in, so Trap Lab stays in demo mode. Pick something long; login
# is rate limited but this is still the only thing standing between a stranger
# and real trap creation. Changing or unsetting it immediately invalidates every
# admin session already issued. Sessions also expire on their own after 24 hours.
ADMIN_KEY=CHANGE_ME_choose_a_long_passphrase
# How many reverse proxies sit in front of the app (default 0 = ignore X-Forwarded-For and use
# the socket address). See "Deploying: the client IP behind a proxy" in the README.
TRUSTED_PROXY_HOPS=0

# Optional: the public address of this API, used as the start of trap and decoy links
# (e.g. https://eidolon-api.onrender.com - https, no path, no trailing slash needed). Without it
# the host of each request is used with https forced (http only on localhost). An invalid value stops startup.
PUBLIC_BASE_URL=

# Local development ONLY: EIDOLON_ENV=dev skips the secret checks above. Never set it on Render.
# EIDOLON_ENV=dev
