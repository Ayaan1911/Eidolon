# Base URL of the Eidolon backend (no trailing path).
# Local dev: the backend on :8001. Optional in dev - api.js falls back to this.
# Production (Vercel): REQUIRED, set in Project Settings -> Environment Variables,
# e.g. https://eidolon-2515.onrender.com. It is baked in at build time, so
# changing it means redeploying.
VITE_API_BASE=http://localhost:8001
